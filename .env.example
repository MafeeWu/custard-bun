APP_CONFIG_PATH=app.config.yml
NODE_ENV=production
# Single quotes preserve literal $ in Compose dotenv parsing (see README).
POSTGRES_PASSWORD='replace-with-a-strong-database-password'
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://127.0.0.1:3000
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-with-smtp-user
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM="Custard Bun <noreply@example.com>"
MODEL_API_BASE_URL=http://127.0.0.1:3102/v1
MODEL_API_KEY=replace-with-model-api-key
MODEL_ID=replace-with-model-id
