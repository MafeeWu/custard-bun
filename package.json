{
  "name": "ai-companion-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "packageManager": "pnpm@12.5.1",
  "scripts": {
    "dev": "next dev",
    "build": "pnpm typecheck && next build",
    "start": "node --env-file-if-exists=.env --import tsx src/server/start.ts",
    "worker": "node --conditions=react-server --env-file-if-exists=.env --import tsx src/worker.ts",
    "health:worker": "node --env-file-if-exists=.env --import tsx src/server/health/check-worker.ts",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "auth:generate": "auth generate --config src/server/auth/auth-cli.ts --output src/server/db/auth-schema.ts --yes",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env --import tsx src/server/db/migrate.ts",
    "db:seed:characters": "node --env-file-if-exists=.env --import tsx src/server/db/seed-characters.ts",
    "db:seed:chat-settings": "node --env-file-if-exists=.env --import tsx src/server/db/seed-chat-settings.ts",
    "db:seed:memory-settings": "node --env-file-if-exists=.env --import tsx src/server/db/seed-memory-settings.ts",
    "db:deploy": "pnpm db:migrate && pnpm db:seed:characters && pnpm db:seed:chat-settings && pnpm db:seed:memory-settings",
    "db:test:up": "docker compose -p ai-companion-test -f compose.test.yml up -d --wait",
    "db:test:down": "docker compose -p ai-companion-test -f compose.test.yml down -v"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.5",
    "auth": "1.7.5",
    "better-auth": "1.7.5",
    "drizzle-orm": "0.45.3",
    "fflate": "0.8.3",
    "js-tiktoken": "1.0.21",
    "next": "16.3.6",
    "nodemailer": "10.0.10",
    "pg": "8.23.0",
    "pg-boss": "12.33.6",
    "pg-connection-string": "2.14.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "server-only": "0.0.1",
    "tsx": "4.23.15",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.13.6",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "drizzle-kit": "0.31.11",
    "eslint": "10.11.0",
    "eslint-config-next": "16.3.6",
    "jsdom": "30.1.1",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  }
}
